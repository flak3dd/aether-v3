# Aether v3 — Foreman Mode
AETHER_API_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Cloud Vertex AI settings (only needed if AETHER_API_PROVIDER=vertex)
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model selection (foreman = planning brain, worker = ephemeral builders, critic = adversarial pass)
AETHER_FOREMAN_MODEL=claude-sonnet-4-6
AETHER_WORKER_MODEL=claude-sonnet-4-6
AETHER_CRITIC_MODEL=claude-sonnet-4-6

# Budgets
AETHER_MAX_TURNS=60
AETHER_THRASH_WINDOW=6            # turns with zero burn-down delta before forced escalation
AETHER_SHELL_TIMEOUT_MS=120000    # per-command; npm install needs more than 30s

# Sandbox: "docker" (preferred) or "host" (dev fallback, NOT isolated)
AETHER_SANDBOX=host
AETHER_DOCKER_IMAGE=node:20-bookworm
